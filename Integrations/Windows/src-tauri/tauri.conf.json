{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexBar",
  "version": "0.1.0",
  "identifier": "app.codexbar.windows",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "CodexBar contributors",
    "copyright": "MIT License. CodexBar (c) Peter Steinberger; Windows port by Vitor de Oliveira.",
    "shortDescription": "AI coding limits in your system tray",
    "longDescription": "Shows usage limits and reset countdowns for Codex, Claude, Cursor, Gemini and Copilot.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}